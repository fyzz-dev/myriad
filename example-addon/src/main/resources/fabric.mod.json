{
	"schemaVersion": 1,
	"id": "myriad-example",
	"version": "${version}",
	"name": "Myriad Example Addon",
	"description": "A complete example addon for the Myriad API: waypoints (module, command, window, HUD, storage), auto tool, chat timestamps and a settings showcase.",
	"authors": ["Myriad contributors"],
	"license": "CC0-1.0",
	"contact": {
		"sources": "https://github.com/fyzz-dev/myriad",
		"issues": "https://github.com/fyzz-dev/myriad/issues"
	},
	"environment": "client",
	"entrypoints": {
		"myriad": ["com.example.myriadaddon.ExampleAddon"]
	},
	"mixins": ["myriad-example.mixins.json"],
	"custom": {
		"myriad": {"updates": false}
	},
	"depends": {
		"myriad": ">=${version}",
		"minecraft": "~${minecraft_version}"
	}
}
